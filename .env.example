POSTGRES_USER=polynomial
POSTGRES_PASSWORD=change-me
POSTGRES_DB=learnings
POSTGRES_PORT=5433

# App connection string (must match the values above)
DATABASE_URL=postgresql://polynomial:change-me@localhost:5433/learnings

# Requires "Authorization: Bearer <key>" on every /v1 route. Leave unset to
# disable the check (local development only).
LEARNINGS_API_KEY=change-me

# Sentence-transformers model used for embeddings. Defaults to
# all-MiniLM-L6-v2 (384 dims). Changing this needs a database whose vector
# column matches the new model's dimension.
# EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2
