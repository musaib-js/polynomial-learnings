POSTGRES_USER=polynomial
POSTGRES_PASSWORD=change-me
POSTGRES_DB=learnings
POSTGRES_PORT=5433

# App connection string (must match the values above)
DATABASE_URL=postgresql://polynomial:change-me@localhost:5433/learnings

# Sentence-transformers model used for embeddings. Defaults to
# all-MiniLM-L6-v2 (384 dims). Changing this needs a database whose vector
# column matches the new model's dimension.
# EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Signing key for dashboard session tokens. Required: the API refuses to
# start while this is unset or left at the built-in placeholder, since
# anyone holding that value could forge a session for any user.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-your-own

# Comma-separated browser origins allowed to call the API. Empty means no
# cross-origin access at all. The dashboard dev server runs on :5173.
CORS_ORIGINS=http://localhost:5173

# API keys for agents are NOT configured here — they are rows in the api_keys
# table, minted and revoked from the dashboard, and stored only as hashes.
